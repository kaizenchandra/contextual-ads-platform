{
  "realm": "contextads",
  "enabled": true,
  "sslRequired": "external",
  "roles": {
    "client": {
      "contextads-api": [
        {
          "name": "ADVERTISER"
        },
        {
          "name": "PUBLISHER"
        },
        {
          "name": "ADMIN"
        }
      ]
    }
  },
  "clients": [
    {
      "clientId": "contextads-api",
      "enabled": true,
      "bearerOnly": true
    },
    {
      "clientId": "contextads-web",
      "enabled": true,
      "secret": "local-web-secret-change-me",
      "publicClient": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:3006/api/auth/callback/keycloak"
      ],
      "webOrigins": [
        "http://localhost:3006"
      ],
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "contextads-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "contextads-test",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
