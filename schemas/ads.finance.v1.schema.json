{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "title":"Contextual advertising finance notifications v1","type":"object","additionalProperties":false,
 "required":["eventId","sequence","schemaVersion","eventType","aggregateType","aggregateId","occurredAt"],
 "properties":{
 "eventId":{"type":"string","format":"uuid"},"sequence":{"type":"integer","minimum":1},"schemaVersion":{"const":1},
 "eventType":{"enum":["DocumentIssued","CashImported","CashMatched","SettlementReserved","SettlementSubmitted","SettlementConfirmed","SettlementCancelled"]},
 "aggregateType":{"enum":["INVOICE","CASH","SETTLEMENT"]},"aggregateId":{"type":"string","format":"uuid"},"occurredAt":{"type":"string","format":"date-time"}
 }
}
