{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Contextual ads durable integration event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "sequence",
    "schemaVersion",
    "eventType",
    "decisionId",
    "occurredAt"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "schemaVersion": {
      "const": 1
    },
    "eventType": {
      "enum": [
        "AdDecisionMade",
        "SpendCommitted",
        "ClickRecorded",
        "ConversionRecorded",
        "FraudSignalTriggered",
        "ChargeValidated",
        "ChargeReversed",
        "TrafficInvalidated"
      ]
    },
    "decisionId": {
      "type": "string",
      "format": "uuid"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
